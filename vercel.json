  "rewrites": [
    {
      "source": "/guide",
      "has": [
        {
          "type": "query",
          "key": "g",
          "value": "^(?<slug>[a-z0-9-]+)$"
        }
      ],
      "destination": "/s/guide-:slug"
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "query",
          "key": "b",
          "value": "^(?<slug>[a-z0-9-]+)$"
        }
      ],
      "destination": "/s/blog-:slug"
    },
    {
      "source": "/living",
      "has": [
        {
          "type": "query",
          "key": "a",
          "value": "^(?<slug>[a-z0-9-]+)$"
        }
      ],
      "destination": "/s/living-:slug"
    },
    {
      "source": "/property",
      "has": [
        {
          "type": "query",
          "key": "p",
          "value": "^(?<slug>[a-z0-9-]+)$"
        }
      ],
      "destination": "/s/property-:slug"
    },
    {
      "source": "/community",
      "has": [
        {
          "type": "query",
          "key": "c",
          "value": "^(?<slug>[a-z0-9-]+)$"
        }
      ],
      "destination": "/s/community-:slug"
    },
    {
      "source": "/developers",
      "has": [
        {
          "type": "query",
          "key": "d",
          "value": "^(?<slug>[a-z0-9-]+)$"
        }
      ],
      "destination": "/s/developer-:slug"
    },
    {
      "source": "/legal",
      "has": [
        {
          "type": "query",
          "key": "doc",
          "value": "^(?<slug>[a-z0-9-]+)$"
        }
      ],
      "destination": "/s/legal-:slug"
    },
    {
      "source": "/guide",
      "destination": "/s/guide-buying"
    },
    {
      "source": "/living",
      "destination": "/s/living-index"
    },
    {
      "source": "/community",
      "destination": "/s/community-index"
    },
    {
      "source": "/developers",
      "destination": "/s/developer-index"
    },
    {
      "source": "/legal",
      "destination": "/s/legal-privacy"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "xrealty123.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.+)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
